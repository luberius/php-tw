{
    "name": "luberius/php-tw",
    "description": "A PHP project template with Tailwind CSS integration",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Syahril A P",
            "email": "callmesyahril@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "symfony/console": "^5.4",
        "symfony/process": "^5.4.51",
        "luberius/tailwindcss": "^1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.62"
    },
    "homepage": "https://github.com/luberius/php-tw",
    "support": {
        "issues": "https://github.com/luberius/php-tw/issues",
        "source": "https://github.com/luberius/php-tw"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:feature": "phpunit --testsuite=Feature",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:coverage-text": "phpunit --coverage-text",
        "post-create-project-cmd": [
            "@php post-create-script.php"
        ]
    },
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/.claude/",
            "/.DS_Store",
            "/.phpunit.result.cache",
            "/vendor/"
        ]
    }
}
